# Backend API Configuration
# URL of the C++ mesh server

# Development: Use explicit URL since frontend runs on different port (3000)
VITE_API_URL=http://127.0.0.1:8080

# Production: When frontend is served from C++ server, use empty string for same-origin
# VITE_API_URL=

# Set to 'true' to always use browser-side parsing (no backend)
# VITE_FORCE_BROWSER_PARSING=false
