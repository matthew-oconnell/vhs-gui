{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VHS CFD GUI",
  "version": "0.1.0",
  "identifier": "com.vhs.cfd-gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "runner": null
  },
  "app": {
    "windows": [
      {
        "title": "VHS CFD GUI",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
