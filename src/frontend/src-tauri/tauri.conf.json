{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VHS CFD GUI",
  "version": "1.0.0-beta.1",
  "identifier": "com.vhs.cfd-gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "runner": null
  },
  "app": {
    "windows": [
      {
        "title": "VHS CFD GUI - BETA",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "rpm"],
    "publisher": "VHS Project",
    "copyright": "Copyright (c) 2026 VHS Project",
    "category": "DeveloperTool",
    "shortDescription": "CFD Simulation Configuration Tool",
    "longDescription": "A native desktop application for configuring computational fluid dynamics simulations with interactive 3D mesh visualization and boundary condition setup.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
